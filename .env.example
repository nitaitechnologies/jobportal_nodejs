NODE_ENV=development
# Local only. Do NOT set PORT on Render — Render injects it automatically.
PORT=5000
API_PREFIX=/api/v1

# Optional: load a specific env file first (does not override already-set vars when using .env.test)
# ENV_FILE=.env.local

# Frontend origins (no wildcards or localhost in production). credentials: true — never use "*".
# Production: required. Use the exact browser origin (scheme + host, no trailing slash).
CLIENT_URL=http://localhost:3000
# Optional React admin origin (omit on Render if unused)
# ADMIN_CLIENT_URL=http://localhost:3001
# Optional comma-separated extra origins (Vite 5173 + Next.js 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Local MongoDB. Production: use MongoDB Atlas (mongodb+srv://...) — never localhost on Render.
MONGODB_URI=mongodb://127.0.0.1:27017/workindia

# Required. In production must be ≥32 chars and not the example placeholder.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Behind a reverse proxy (Render, nginx, ALB), set to 1 so rate limits use the client IP.
# Defaults to 1 when NODE_ENV=production. Local development: 0.
TRUST_PROXY=0

# Auth login/register rate limits (in-memory; Redis later for multi-instance)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Candidate mobile OTP (dummy until SMS provider is wired).
# Fixed code is always accepted after /otp/send. Clear CANDIDATE_OTP_DUMMY for real OTP later.
CANDIDATE_OTP_DUMMY=123456
CANDIDATE_OTP_TTL_SECONDS=300

# Email notifications (sheet 473). Without SMTP_*, emails are logged only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@workindia.in
# SMTP_SECURE=false

# Push notifications (sheet 472). Without FCM_SERVER_KEY, pushes are logged only.
# FCM_SERVER_KEY=

# Optional SMS provider key for live OTP (sheet 474).
# SMS_PROVIDER_API_KEY=

# OpenAI / ChatGPT — AI resume (092–093), matching (102/107), career coach (109–112),
# employer recruitment assistant + AI interview (293–303).
# Never commit real keys. When empty, AI routes return 404 and /me feature flags are false.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ENABLE_AI_RESUME=true
# ENABLE_AI_MATCHING=true
# ENABLE_AI_CAREER_COACH=true
# ENABLE_AI_RECRUITMENT=true
# Runtime on/off for each AI feature is admin PATCH /api/v1/admin/ai-features.
# Clients read the effective flags from /me (candidate, employer, and admin).
# AI_RESUME_RATE_LIMIT_WINDOW_MS=900000
# AI_RESUME_RATE_LIMIT_MAX=20
# AI_COACH_RATE_LIMIT_WINDOW_MS=900000
# AI_COACH_RATE_LIMIT_MAX=30
# AI_RECRUITMENT_RATE_LIMIT_WINDOW_MS=900000
# AI_RECRUITMENT_RATE_LIMIT_MAX=40

# Realtime chat (Socket.IO) — candidate ↔ employer messaging
# ENABLE_CHAT=true

# OpenAPI / Swagger (B26) — default on in non-production; off by default in production
ENABLE_API_DOCS=true
# Optional public host listed in OpenAPI servers (no trailing slash)
# API_PUBLIC_URL=https://api.example.com
# Optional staging server entry in OpenAPI (no trailing slash)
# STAGING_API_URL=https://staging-api.example.com

# Storage (B23) — local by default; s3/r2 adapters can be added later
# Render disk is ephemeral unless you attach a persistent Disk. Uploads will not survive deploys.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
UPLOAD_MAX_BYTES=5242880

# Video JD + video resume (local storage for now; Bunny CDN later).
# When false, /me returns features.*.Enabled=false and video routes return 404 — clients must hide UI.
ENABLE_VIDEO_JD=false
ENABLE_VIDEO_RESUME=false
VIDEO_MAX_BYTES=2097152
VIDEO_MAX_SECONDS=40

# Office / candidate place search. When set, both apps use Google-listed places.
# When empty, the API uses OpenStreetMap so distance still works locally.
# GOOGLE_MAPS_API_KEY=

# Demo seed — development/demo/staging only. Never seed or reset production databases.
# SEED_MODE=demo
# Optional shared password for all @workindia.demo accounts (8–128 chars). Never commit real secrets.
# SEED_DEMO_PASSWORD=12345678
# Destructive reset confirmation — set automatically by `npm run seed:reset`. Do not set in production.
# SEED_ALLOW_RESET=1
# Only if MongoDB host looks production-like but is intentionally a non-prod demo DB:
# SEED_CONFIRM_TARGET=demo
# Razorpay (sheet 358). Leave empty to keep simulated checkout (confirm/fail).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

EMPLOYER_MAX_SESSIONS=5
# Team invite link validity (days)
EMPLOYER_TEAM_INVITE_TTL_DAYS=7
